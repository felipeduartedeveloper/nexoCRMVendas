# URL pública da API (backend no Docker exposto via Cloudflare Tunnel).
# O Vite embute isto no build de produção (vite build). A URL não é segredo.
# IMPORTANTE: este projeto lê VITE_API_BASE_URL e o backend tem prefixo /api,
# então a URL inclui /api no final.
# Para sobrescrever na Vercel, defina VITE_API_BASE_URL nas Environment Variables.
VITE_API_BASE_URL=https://sales-api.oxlify.com/api

# Site key do Cloudflare Turnstile (captcha no login). Pública (vai no bundle).
# Vazio = o widget não renderiza. Defina com a site key do widget Turnstile.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAADXOzGEuLCayN0LS
