# ============================================================================
# crmvendas — variáveis de ambiente
# Copie pra .env e ajuste os valores antes de subir o docker compose.
# ============================================================================

# ---- Node ----
NODE_ENV=development

# ---- Postgres ----
POSTGRES_USER=crmvendas
POSTGRES_PASSWORD=crmvendaspass
POSTGRES_DB=crmvendas_db
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_PASSWORD=redispass
REDIS_PORT=6379

# ---- MinIO (S3-compatible) ----
MINIO_ROOT_USER=crmvendasminio
MINIO_ROOT_PASSWORD=crmvendasminiopass
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=http://localhost:9000
S3_BUCKET=crmvendas-attachments
S3_REGION=us-east-1

# ---- Backend ----
BACKEND_PORT=3000
DB_SYNC=true
DB_RUN_MIGRATIONS=false
JWT_ACCESS_SECRET=change-this-access-secret
JWT_REFRESH_SECRET=change-this-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=10
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ---- Bootstrap super admin ----
ADMIN_BOOTSTRAP_EMAIL=admin@crmvendas.local
ADMIN_BOOTSTRAP_PASSWORD=Admin@123

# ---- SMTP (opcional — sem isso e-mails só são logados) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=crmvendas <no-reply@crmvendas.local>

# ---- URLs públicas ----
APP_PUBLIC_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000

# ---- Frontend / Admin ----
FRONTEND_PORT=5173
ADMIN_PORT=5174
NGINX_PORT=8081
